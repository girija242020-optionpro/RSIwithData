PORT=10000
HOST=0.0.0.0
CORS_ORIGIN=*

# Dhan authentication. Prefer TOTP on Render so the server can renew a 24h token.
DHAN_CLIENT_ID=YOUR_DHAN_CLIENT_ID
DHAN_PIN=YOUR_DHAN_PIN
DHAN_TOTP_SECRET=YOUR_DHAN_TOTP_SECRET
# Alternative: paste a valid 24-hour token instead of using TOTP.
# DHAN_ACCESS_TOKEN=YOUR_24_HOUR_ACCESS_TOKEN

NIFTY_SECURITY_ID=13
NIFTY_SEGMENT=IDX_I
AUTO_SUBSCRIBE=true
CHAIN_REFRESH_MS=3200
DEPTH_CONTRACTS=20
STALE_AFTER_MS=5000
MAX_CLIENTS=30
TICK_BUFFER_SIZE=20000

VAPID_PUBLIC_KEY=REPLACE_WITH_YOUR_PUBLIC_KEY
VAPID_PRIVATE_KEY=REPLACE_WITH_YOUR_PRIVATE_KEY
VAPID_SUBJECT=mailto:YOUR_EMAIL@example.com
